meta {
  name: Fill cart to thirteen units
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/customers/100/cart/items/44
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {"quantity":10,"expectedVersion":1}
}

tests {
  test("commits the second valid update", function () {
    expect(res.status).to.equal(200);
    expect(res.body.version).to.equal(2);
    expect(res.body.totalQuantity).to.equal(13);
  });
}
