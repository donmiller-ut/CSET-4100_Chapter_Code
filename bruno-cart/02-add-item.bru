meta {
  name: Add item transactionally
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/customers/100/cart/items/43
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {"quantity":2,"expectedVersion":0}
}

tests {
  test("commits item and summary together", function () {
    expect(res.status).to.equal(200);
    expect(res.body.version).to.equal(1);
    expect(res.body.totalQuantity).to.equal(3);
    expect(res.body.items.some((item) => item.productId === 43 && item.quantity === 2)).to.equal(true);
  });
}
