meta {
  name: Get seeded cart
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/customers/100/cart
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns the versioned seed cart", function () {
    expect(res.status).to.equal(200);
    expect(res.body.version).to.equal(0);
    expect(res.body.totalQuantity).to.equal(1);
    expect(res.body.items).to.have.lengthOf(1);
  });
}
